ARG BASE_VERSION=15.1
ARG NODE_VERSION=24

# Builder: the Elixir release, built from the release tarball the way
# upstream's Dockerfile does (MIX_ENV=ce), on FreeBSD's own erlang/elixir.
# base-exec rather than base-core so one BASE_VERSION names both stages.
FROM ghcr.io/daemonless/base-exec:${BASE_VERSION} AS builder
ARG NODE_VERSION
ARG APP_VERSION="latest"
ARG UPSTREAM_URL="https://api.github.com/repos/plausible/analytics/releases/latest"
ARG UPSTREAM_JQ=".tag_name"

# bcrypt_elixir is a C NIF (elixir_make runs gmake on FreeBSD); mjml is a
# Rust NIF with no FreeBSD prebuilt, so MJML_BUILD makes cargo build it.
# Erlang and Elixir come later, at the versions the release was made with.
# The FreeBSD-*-dev packages hold the linker symlinks of base libraries that
# Rust's std links (-lexecinfo -lkvm -lprocstat -ldevstat -lutil). pkgbase
# has no make(1) here and siphash's GNU Makefile calls "make" by name.
RUN pkg update && \
    pkg install -y \
    FreeBSD-clang FreeBSD-clang-dev FreeBSD-clibs-dev FreeBSD-toolchain \
    FreeBSD-libexecinfo-dev FreeBSD-openssl-dev FreeBSD-runtime-dev \
    FreeBSD-utilities-dev FreeBSD-zlib-dev \
    node${NODE_VERSION} npm-node${NODE_VERSION} \
    rust gmake cmake git jq ca_root_nss && \
    pkg clean -ay && rm -rf /var/cache/pkg/* /var/db/pkg/repos/* && \
    ln -s /usr/local/bin/gmake /usr/local/bin/make

ENV MIX_ENV=ce \
    NODE_ENV=production \
    MJML_BUILD=true \
    LANG=C.UTF-8 \
    PATH="/usr/local/elixir/bin:/usr/local/lib/erlang-upstream/bin:${PATH}"

# The release tarball. The API answer can be empty when the runner's IP is
# rate-limited; the releases/latest redirect carries the tag too.
RUN <<CMD_EOF
set -e
TAG="${APP_VERSION}"
if [ "$TAG" = "latest" ]; then
    TAG=$(fetch -qo - "${UPSTREAM_URL}" | jq -r "${UPSTREAM_JQ}" || true)
    if [ -z "$TAG" ] || [ "$TAG" = "null" ]; then
        TAG=$(fetch -v -o /dev/null https://github.com/plausible/analytics/releases/latest 2>&1 | sed -n 's|.*/releases/tag/\([^ ]*\).*|\1|p' | head -1)
    fi
fi
[ -n "$TAG" ] || { echo "no release tag found"; exit 1; }
echo "${TAG#v}" > /version
fetch -qo /tmp/src.tar.gz "https://github.com/plausible/analytics/archive/refs/tags/${TAG}.tar.gz"
mkdir -p /src && tar -xzf /tmp/src.tar.gz -C /src --strip-components 1 && rm /tmp/src.tar.gz
CMD_EOF

# The Erlang/OTP and Elixir the release pins (its Dockerfile's hexpm/elixir
# image): a dep locked for OTP 27 does not compile on 28 (x509 0.9.1). OTP
# is FreeBSD's erlang-runtimeNN package, kept out of PATH by design, so it
# is linked where PATH expects it; Elixir is the precompiled zip Elixir
# publishes per OTP major, checked against its sha256.
RUN <<CMD_EOF
set -e
set -- $(sed -n 's|^FROM hexpm/elixir:\([0-9.]*\)-erlang-\([0-9.]*\)-.*|\1 \2|p' /src/Dockerfile | head -1)
ELIXIR="$1" OTP="$2"
[ -n "$ELIXIR" ] && [ -n "$OTP" ] || { echo "no hexpm/elixir FROM in the upstream Dockerfile"; exit 1; }
MAJOR="${OTP%%.*}"
echo "Erlang/OTP ${MAJOR} (upstream ${OTP}), Elixir ${ELIXIR}"
pkg install -y "erlang-runtime${MAJOR}" && pkg clean -ay && rm -rf /var/cache/pkg/* /var/db/pkg/repos/*
ln -s "/usr/local/lib/erlang${MAJOR}" /usr/local/lib/erlang-upstream
URL="https://github.com/elixir-lang/elixir/releases/download/v${ELIXIR}/elixir-otp-${MAJOR}.zip"
fetch -qo /tmp/elixir.zip "$URL"
fetch -qo /tmp/elixir.zip.sha256sum "${URL}.sha256sum"
sha256 -q -c "$(cut -d' ' -f1 /tmp/elixir.zip.sha256sum)" /tmp/elixir.zip
mkdir -p /usr/local/elixir && unzip -q /tmp/elixir.zip -d /usr/local/elixir && rm /tmp/elixir.zip*
erl -noshell -eval 'io:format("~s~n", [erlang:system_info(otp_release)]), halt().' && elixir --version
CMD_EOF

WORKDIR /src

# mjml builds its NIF only with rustler present, an optional dep Plausible
# does not lock (it ships prebuilt NIFs for Linux); add it for the build.
RUN <<CMD_EOF
set -e
sed -i '' 's|^  defp deps do$|  defp deps do [{:rustler, ">= 0.0.0", optional: true, runtime: false}] ++|' mix.exs
grep -q ':rustler' mix.exs
mix local.hex --force && mix local.rebar --force
mix deps.get --only ce
APP_VERSION=$(cat /version) mix deps.compile
CMD_EOF

# Assets. The tailwind hex package downloads a standalone binary that has no
# FreeBSD build; its npm CLI has one (@tailwindcss/oxide-freebsd-x64), so
# point the package at that, at the version config.exs pins.
RUN <<CMD_EOF
set -e
TW=$(sed -n '/^config :tailwind/,/version:/ s/.*version: "\([^"]*\)".*/\1/p' config/config.exs | head -1)
[ -n "$TW" ] || { echo "no tailwind version in config/config.exs"; exit 1; }
npm install --prefix ./assets
npm install --prefix ./tracker
# Its own prefix: installing it into assets/ re-resolved that tree and
# dropped 70 packages esbuild needs.
npm install --prefix /opt/tailwind "@tailwindcss/cli@${TW}"
# app.css starts with @import "tailwindcss", which the standalone binary
# bundles; the CLI resolves it from the CSS file's tree instead, where npm
# put a tailwindcss 3 (a peer of @tailwindcss/typography) with no CSS entry.
rm -rf /src/assets/node_modules/tailwindcss
ln -s /opt/tailwind/node_modules/tailwindcss /src/assets/node_modules/tailwindcss
/opt/tailwind/node_modules/.bin/tailwindcss --input=assets/css/app.css --output=/dev/null
# The tracker minifies with @swc/core, which has no FreeBSD binding. Its
# fallback to @swc/wasm cannot engage (index.js requires the native binding
# before it), and the tracker only calls minifySync, which @swc/wasm exports
# with the same signature: so here @swc/core is @swc/wasm.
SWC=$(node -p "require('./tracker/node_modules/@swc/core/package.json').version")
npm install --prefix ./tracker --no-save "@swc/wasm@${SWC}"
printf 'module.exports = require("@swc/wasm");\n' > tracker/node_modules/@swc/core/index.js
node -e 'const s = require("/src/tracker/node_modules/@swc/core"); if (!s.minifySync("var  a = 1;", {}).code) throw new Error("swc wasm minify failed")'
cat >> config/ce.exs <<'EOF2'

# daemonless: no standalone tailwind binary for FreeBSD; the npm CLI instead
config :tailwind,
  version_check: false,
  path: "/opt/tailwind/node_modules/.bin/tailwindcss"
EOF2
CMD_EOF

RUN export APP_VERSION=$(cat /version) && \
    npm run deploy --prefix ./tracker && \
    mix assets.deploy && \
    mix download_country_database && \
    mix sentry.package_source_code && \
    mix release plausible && \
    rm -rf /root/.cache /root/.cargo/registry /root/.npm

# Production image: the release carries its own Erlang runtime.
FROM ghcr.io/daemonless/base-exec:${BASE_VERSION}

ARG FREEBSD_ARCH=amd64
ARG PACKAGES="ca_root_nss"
ARG UPSTREAM_URL="https://api.github.com/repos/plausible/analytics/releases/latest"
ARG UPSTREAM_JQ=".tag_name"
{%- if ports %}
ARG HEALTHCHECK_ENDPOINT="http://127.0.0.1:{{ ports[0].port }}/api/health"
{%- else %}
ARG HEALTHCHECK_ENDPOINT="http://127.0.0.1:8000/api/health"
{%- endif %}

ENV HEALTHCHECK_URL="${HEALTHCHECK_ENDPOINT}"

# --- Metadata (Injected by Generator) ---
LABEL org.opencontainers.image.title="{{ title }}" \
      org.opencontainers.image.description="{{ description }}" \
      org.opencontainers.image.source="{{ repo_url }}" \
      org.opencontainers.image.url="{{ web_url }}" \
      org.opencontainers.image.documentation="https://github.com/plausible/community-edition/wiki" \
      org.opencontainers.image.licenses="AGPL-3.0" \
      org.opencontainers.image.vendor="daemonless" \
      org.opencontainers.image.authors="daemonless" \
      io.daemonless.category="{{ category }}" \
{%- if ports %}
      io.daemonless.port="{{ ports[0].port }}" \
{%- endif %}
{%- if volumes %}
      io.daemonless.volumes="{{ volumes | map(attribute='path') | join(',') }}" \
{%- endif %}
{%- if mlock %}
      org.freebsd.jail.allow.mlock="required" \
{%- endif %}
      io.daemonless.arch="${FREEBSD_ARCH}" \
      io.daemonless.upstream-url="${UPSTREAM_URL}" \
      io.daemonless.upstream-jq="${UPSTREAM_JQ}" \
      io.daemonless.healthcheck-url="${HEALTHCHECK_ENDPOINT}" \
      io.daemonless.packages="${PACKAGES}"

RUN pkg update && \
    pkg install -y ${PACKAGES} && \
    pkg clean -ay && rm -rf /var/cache/pkg/* /var/db/pkg/repos/*

COPY --from=builder /src/_build/ce/rel/plausible /app
COPY --from=builder /version /app/version
RUN chmod -R a+rX /app && mkdir -p /config && chown bsd:bsd /config

COPY root/ /
RUN chmod +x /daemonless/libexec/plausible /daemonless/init.d/*

CMD ["/daemonless/libexec/plausible"]

# The release renders its runtime config into RELEASE_TMP; /app is read-only
# for bsd, so that and TMPDIR live under the volume. DEFAULT_DATA_DIR is
# where Plausible keeps its own files (geolocation database, caches).
ENV MIX_ENV=ce \
    LANG=C.UTF-8 \
    LISTEN_IP=0.0.0.0 \
    HTTP_PORT=8000 \
    DEFAULT_DATA_DIR=/config \
    TMPDIR=/config/tmp \
    RELEASE_TMP=/config/tmp

# --- Expose (Injected by Generator) ---
{%- if ports %}
EXPOSE {{ ports | map(attribute='port') | join(' ') }}
{%- endif %}

# --- Volumes (Injected by Generator) ---
{%- if volumes %}
VOLUME {{ volumes | map(attribute='path') | join(' ') }}
{%- endif %}
